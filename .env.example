# TODO: add provider-specific variables if more local backends are introduced.

# Host-side LM Studio endpoint.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL_NAME=local-model
LMSTUDIO_TIMEOUT_SECONDS=60
LMSTUDIO_MAX_RETRIES=2

# Override this to host.docker.internal when the Python process runs in Docker on macOS.
# LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1

# Local ROM path used by the scaffold config loader.
ZORK1_GAME_PATH=games/zork1.z5
DOCKER_SMOKE_CONFIG=configs/zork1_local.yaml

# Optional artifact overrides.
ZORK_AGENT_TRAJECTORY_DIR=artifacts/trajectories
ZORK_AGENT_ARCHIVE_DIR=artifacts/archive
ZORK_AGENT_LOG_DIR=artifacts/logs
